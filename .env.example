# ==============================================================================
# GeekPortal Frontend Environment Configuration (.env.example)
# ==============================================================================
# Duplicate this file as '.env' or '.env.local' and adjust values for your environment.

# ------------------------------------------------------------------------------
# 1. Core Backend & Platform API
# ------------------------------------------------------------------------------
# Primary backend API server (Express / Go service)
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# Canonical public site URL (used for SEO metadataBase, OpenGraph, sitemap, and robots.txt)
NEXT_PUBLIC_SITE_URL=https://opencode.iiita.ac.in

# Subpath prefix if deploying under a nested URL (e.g. /portal). Leave blank for root.
NEXT_PUBLIC_BASE_PATH=

# ------------------------------------------------------------------------------
# 2. OpenCode Event Configuration
# ------------------------------------------------------------------------------
# Active event identifier used across leaderboards, participant profile stats, and admin views
NEXT_PUBLIC_EVENT_NAME="OPENCODE'26"

# Event start date in YYYY-MM-DD format (used for timeline charts and leaderboards)
NEXT_PUBLIC_EVENT_START_DATE=2025-12-14

# ------------------------------------------------------------------------------
# 3. Geekstore & Merchandise
# ------------------------------------------------------------------------------
# External order fulfillment form URL (Google Form / Typeform) for checkout flow
NEXT_PUBLIC_GEEKSTORE_FORM_URL=https://forms.google.com

# ------------------------------------------------------------------------------
# 4. Geekstore Product Image Uploads (Backend Cloudinary)
# ------------------------------------------------------------------------------
# Product image uploads are handled centrally by the backend server
# (gh-portal-backend at NEXT_PUBLIC_BACKEND_URL, default: http://localhost:4000)
# via POST /api/v1/admin/geekstore/upload.
# Cloudinary credentials (CLOUD_NAME, CLOUD_API_KEY, CLOUD_API_SECRET) live in
# gh-portal-backend/.env and are NOT required in frontend .env.
#
# Optional frontend fallback overrides (only used if running frontend standalone):
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# CLOUDINARY_UPLOAD_PRESET=

# ------------------------------------------------------------------------------
# 5. r/Place Collaborative Canvas Service
# ------------------------------------------------------------------------------
# WebSocket endpoint for real-time live canvas pixel streaming
NEXT_PUBLIC_RPLACE_WS_URL=ws://localhost:3001/ws

# Public HTTP API endpoint for canvas snapshots, leaderboard, and cooldown checks
NEXT_PUBLIC_RPLACE_API_URL=http://localhost:3001/api

# Internal server-side API URL for Next.js route handlers proxying requests (optional)
RPLACE_INTERNAL_API_URL=http://localhost:3001

# ------------------------------------------------------------------------------
# 6. Build & Diagnostics (Optional)
# ------------------------------------------------------------------------------
# Set to 'true' to trigger @next/bundle-analyzer visualizer on 'npm run build'
ANALYZE=false